# MySQL container
MYSQL_ROOT_PASSWORD=redis_practice
MYSQL_DATABASE=redis_practice
MYSQL_USER=redis_user
MYSQL_PASSWORD=redis_password

# Backend database connection
DB_HOST=db
DB_PORT=3306
DB_USER=redis_user
DB_PASSWORD=redis_password
DB_NAME=redis_practice

# Redis connection
REDIS_HOST=redis
REDIS_PORT=6379

# Backend HTTP server
SERVER_PORT=8080

# Flyway migration
FLYWAY_URL=jdbc:mysql://db:3306/redis_practice?allowPublicKeyRetrieval=true&useSSL=false
FLYWAY_SCHEMAS=redis_practice
FLYWAY_USER=redis_user
FLYWAY_PASSWORD=redis_password
FLYWAY_CONNECT_RETRIES=60
FLYWAY_LOCATIONS=filesystem:/flyway/sql
